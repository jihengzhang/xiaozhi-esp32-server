    {
        "name": "load_patient",
        "category": "patient_management",
        "description": "Loads a patient item from the MRI work list.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "index": {
                    "type": "string",
                    "description": "The record order on the work list UI"
                },
                "patient_id": {
                    "type": "string",
                    "description": "Optional patient ID to filter the record"
                },
                "record_type": {
                    "type": "string",
                    "enum": ["local", "ris", "all"],
                    "description": "The type of record to retrieve",
                    "default": "all"
                }
            }
        }
    },
    {
        "name": "create_patient",
        "category": "patient_management",
        "description": "Creates a patient record.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "patient_id": {
                    "type": "string",
                    "description": "The unique patient identifier"
                },
                "weight": {
                    "type": "string",
                    "description": "The patient's weight in kilograms"
                }
            }
        }
    },
    {
        "name": "get_pulse_sequences",
        "category": "scan_control",
        "description": "获取设备支持的所有脉冲序列列表",
        "inputSchema": {
            "type": "object",
            "properties": {}
        },
        "mockResponse": {
            "sequences": ["T1", "T2", "FLAIR", "GRE", "SPGR", "DWI", "DTI"]
        }
    },
    {
        "name": "set_scan_parameters",
        "category": "scan_control",
        "description": "设置 MRI 扫描参数（重复时间、回波时间、翻转角度）",
        "inputSchema": {
            "type": "object",
            "properties": {
                "sequence": {
                    "type": "string",
                    "description": "脉冲序列名称 (e.g., 'T1', 'T2')"
                },
                "tr": {
                    "type": "number",
                    "description": "重复时间 (ms)",
                    "default": 1000
                },
                "te": {
                    "type": "number",
                    "description": "回波时间 (ms)",
                    "default": 30
                },
                "flip_angle": {
                    "type": "number",
                    "description": "翻转角度 (度)",
                    "default": 90
                }
            },
            "required": ["sequence"]
        }
    },

    {
