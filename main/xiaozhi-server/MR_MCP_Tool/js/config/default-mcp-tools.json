    {
        "name": "set_parameter",
        "category": "task_management",
        "description": "Set a specific parameter for a task or series identified by its index. If no index is specified, set the default one's parameter.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "index": {
                    "type": "string",
                    "description": "The index of the task or series in the task or series list"
                },
                "param_name": {
                    "type": "string",
                    "description": "The name of the parameter to set"
                },
                "param_value": {
                    "type": "string",
                    "description": "The value to assign to the parameter"
                }
            }
        }
