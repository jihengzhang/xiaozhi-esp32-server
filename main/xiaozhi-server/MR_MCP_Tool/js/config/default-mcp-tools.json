                    "description": "The name of the protocol library"
                },
                "protocol_name": {
                    "type": "string",
                    "description": "The name or identifier of the protocol to load (e.g., 'Brain Routine')"
                }
            }
        }
    },
    {
        "name": "select_task_or_series",
